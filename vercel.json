{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "parissportweek.com" }],
      "destination": "https://parissportweek.fr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.parissportweek.com" }],
      "destination": "https://parissportweek.fr/$1",
      "permanent": true
    }
  ]
}
